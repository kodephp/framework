# Composer 分发归档（create-project / require 下载的 zip）导出规则。
# 仅影响分发包，不改 git 仓库内容；框架自身的 src/ 必须保留（消费者依赖它）。

# 开发/文档产物不进入分发包（仅影响 composer require 的 vendor 压缩包，不影响 git clone / create-project）
/tests/                export-ignore
/.workbuddy/           export-ignore
/.github/              export-ignore

# 说明：v1.0.0 起本仓库收敛为纯内核，app/ config/ public/ database/ lang/ 已移除
# （骨架独立为 kode/skeleton 仓库）。tests/skeleton/ 是集成测试夹具，随 /tests/ 一并排除。

# 运行时产物（仅保留目录占位 .gitkeep，由 bin/kode init 重建）
/storage/cache/*       export-ignore
/storage/logs/*        export-ignore
/storage/framework/*   export-ignore
/storage/heartbeat.log export-ignore
