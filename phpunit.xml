<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="false"
         failOnNotice="false">
    <testsuites>
        <testsuite name="Kode Framework Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <!-- 测试用 /metrics 令牌（protect=token）。config 为进程级单例，只能于首次 boot 前注入。 -->
        <env name="OBS_METRICS_PROTECT" value="token"/>
        <env name="OBS_METRICS_TOKEN" value="test-token"/>
    </php>
</phpunit>
