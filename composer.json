{
    "name": "kode/framework",
    "description": "Kode Framework —— 以 kode/core 为启动器、kode/runtime 为统一运行时（Swoole/Swow/Fiber/多进程/多线程）的现代 PHP 全栈框架，组合 kode 生态与 Monolog、Symfony Validator 等成熟包。",
    "type": "library",
    "keywords": [
        "framework",
        "kode",
        "core",
        "runtime",
        "di",
        "router",
        "http",
        "console",
        "aop",
        "process",
        "fibers",
        "parallel",
        "coroutine",
        "psr"
    ],
    "license": "MIT",
    "version": "3.1.1",
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/kodephp/database.git"
        },
        {
            "type": "git",
            "url": "https://github.com/kodephp/http.git"
        }
    ],
    "authors": [
        {
            "name": "kode"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-sockets": "*",
        "kode/aop": "^4",
        "kode/attributes": "^3",
        "kode/cache": "^2",
        "kode/console": "^5",
        "kode/context": "^4",
        "kode/core": "^2",
        "kode/database": "^2",
        "kode/di": "^3",
        "kode/event": "^3",
        "kode/exception": "^4",
        "kode/facade": "^4",
        "kode/fibers": "^5",
        "kode/http": "^4",
        "kode/http-client": "^3",
        "kode/jwt": "^3",
        "kode/limiting": "^3",
        "kode/messaging": "^5",
        "kode/middleware": "^2",
        "kode/parallel": "^2",
        "kode/process": "^7",
        "kode/queue": "^3",
        "kode/router": "^3",
        "kode/runtime": "^4",
        "kode/scheduling": "^2",
        "kode/session": "^4",
        "monolog/monolog": "^3.0",
        "nyholm/psr7": "^1.8",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "symfony/translation": "^7.0",
        "symfony/validator": "^7.0"
    },
    "suggest": {
        "ext-curl": "cURL 扩展 - 用于 OTLP 导出/异步 HTTP 客户端"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "support": {
        "issues": "https://github.com/kodephp/framework/issues",
        "source": "https://github.com/kodephp/framework"
    },
    "autoload": {
        "psr-4": {
            "Kode\\Framework\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\Framework\\Tests\\": "tests/",
            "app\\": "tests/skeleton/app/"
        }
    },
    "bin": [
        "kode"
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "minimum-stability": "dev",
        "prefer-stable": true,
        "allow-plugins": {
            "*": true
        }
    },
    "scripts": {
        "start": "php kode start",
        "serve": "php kode start",
        "console": "php kode console",
        "init": "php kode init",
        "test": "php vendor/bin/phpunit"
    }
}
