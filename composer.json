{
    "name": "kode/framework",
    "description": "Kode Framework —— 以 kode/core 为启动器、kode/runtime 为统一运行时（Swoole/Swow/Fiber/多进程/多线程）的现代 PHP 全栈框架，组合 kode 生态（di/router/http/console/aop/cache/event/jwt/facade...）与 Monolog、Symfony Validator 等成熟包。",
    "type": "library",
    "keywords": [
        "framework",
        "kode",
        "core",
        "runtime",
        "di",
        "router",
        "http",
        "console",
        "aop",
        "process",
        "fibers",
        "parallel",
        "coroutine",
        "psr"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "kode"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-sockets": "*",
        "kode/aop": "*",
        "kode/attributes": "*",
        "kode/cache": "*",
        "kode/console": "*",
        "kode/context": "*",
        "kode/core": "*",
        "kode/database": "^1.15.5",
        "kode/di": "*",
        "kode/event": "*",
        "kode/exception": "*",
        "kode/facade": "*",
        "kode/fibers": "*",
        "kode/http": "*",
        "kode/http-client": "^2.5",
        "kode/jwt": "*",
        "kode/limiting": "^2.0",
        "kode/messaging": "^3.3",
        "kode/middleware": "*",
        "kode/parallel": "*",
        "kode/process": "*",
        "kode/queue": "^2.2",
        "kode/router": "*",
        "kode/runtime": "*",
        "kode/scheduling": "^1.3",
        "kode/session": "*",
        "monolog/monolog": "^3.0",
        "nyholm/psr7": "^1.8",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "symfony/translation": "^7.0",
        "symfony/validator": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "cweagans/composer-patches": "^1.7"
    },
    "autoload": {
        "psr-4": {
            "Kode\\Framework\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\Framework\\Tests\\": "tests/",
            "App\\": "app/"
        }
    },
    "bin": [
        "bin/kode"
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "minimum-stability": "dev",
        "prefer-stable": true,
        "allow-plugins": {
            "*": true
        }
    },
    "extra": {
        "patches": {
            "kode/database": {
                "PdoConnection 常驻内存优化：去 SELECT 1 探活 + 预编译语句缓存（上限 256），连接失效自动重连重试一次，Swoole 常驻场景提速约 2x": "patches/kode-database-pdoconnection.patch"
            },
            "kode/http": {
                "Response::json 直构 + Swoole 发射走内部字符串体，削减常驻内存吞吐路径的每请求开销": "patches/kode-http-response-optimize.patch"
            }
        }
    },
    "scripts": {
        "serve": "php bin/kode serve",
        "console": "php bin/console",
        "new": "php bin/kode new",
        "init": "php bin/kode init",
        "post-create-project-cmd": "php bin/kode init",
        "test": "php vendor/bin/phpunit"
    }
}
