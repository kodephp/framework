APP_NAME=kode-app
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai

LOG_LEVEL=debug
LOG_FORMAT=line

JWT_SECRET=__GENERATED_ON_INIT__ # bin/kode init 将自动替换为 bin2hex(random_bytes(32)) 强随机值
JWT_ALGO=HS256
JWT_TTL=3600

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=forge
DB_USERNAME=forge
DB_PASSWORD=
DB_POOL_ENABLED=false

CACHE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

SERVER_HOST=127.0.0.1
SERVER_PORT=9527
SERVER_WORKERS=0
SERVER_GRACE_PERIOD=30
K8S_TERMINATION_GRACE_PERIOD=40

SECURITY_HEADERS_ENABLED=false
SESSION_SECURE=false

# ------------------------------------------------------------------
# 可观测性（指标 + 链路追踪）
# ------------------------------------------------------------------
OBS_METRICS_ENABLED=true
OBS_METRICS_PROTECT=token
OBS_METRICS_TOKEN=
OBS_METRICS_SAMPLE_RATIO=0.1
OBS_TRACING_ENABLED=true
OBS_TRACING_SAMPLE_RATIO=0.1
# 响应是否回写 W3C 链路头（traceparent + X-Trace-Id + X-Span-Id）。
# true（默认）：每个响应带链路头，网关/日志/APM 可直接串联；
# false：仅建立内部 trace 上下文（日志关联/下游串联/异常 tracer 桥接），不回写响应头，省去每请求开销。
OBS_TRACING_ATTACH_HEADERS=true
