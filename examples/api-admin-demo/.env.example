APP_NAME=kode-api-admin-demo
APP_DEBUG=true
APP_ENV=local
APP_TIMEZONE=Asia/Shanghai

# 数据库：默认 SQLite 文件（storage/database.sqlite），零依赖即可运行。
# 生产环境切换到 MySQL：DB_CONNECTION=mysql 并填写下方连接信息。
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=forge
DB_USERNAME=forge
DB_PASSWORD=
DB_SQLITE_PATH=storage/database.sqlite

# JWT（请改成足够长的随机串，例如 openssl rand -hex 32）
JWT_SECRET=please-change-me-to-a-long-random-secret-string
JWT_TTL=3600
JWT_REFRESH_TTL=86400
