#!/usr/bin/env php
<?php

declare(strict_types=1);

define('KODE_START_TIME', microtime(true));

/**
 * Kode Framework 命令行工具
 *
 * 用法：
 *   bin/kode init                    初始化当前项目（生成 .env + storage/，composer create-project 后自动执行）
 *   bin/kode start [--host H] [--port P] [--workers N]
 *                                    启动多进程 HTTP 服务（kode/process master-worker，serve 为别名）
 *   bin/kode console <args...>        透传执行控制台命令
 *   bin/kode help                     帮助
 *
 * 作为 composer 包发布后，用户安装 kode/framework 即可通过 vendor/bin/kode 调用。
 * 新项目请用骨架仓库：composer create-project kode/skeleton <项目名>
 * （自动下载 + composer install + 初始化；本仓库自 v1.0.0 起为纯内核，不再自带骨架模板）。
 */

// ---- 定位自动加载器（兼容「仓库内」与「composer 安装后」两种上下文）----
$packageRoot = dirname(__DIR__);
$autoloadCandidates = [
    $packageRoot . '/vendor/autoload.php',
    realpath($packageRoot . '/../../../autoload.php'),
];
$autoload = null;
foreach ($autoloadCandidates as $candidate) {
    if ($candidate !== false && is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}
if ($autoload === null) {
    fwrite(STDERR, "无法定位 vendor/autoload.php，请在项目根目录运行。\n");
    exit(1);
}
require $autoload;

use Kode\Attributes\Reader;
use Kode\Framework\Application;
use Kode\Framework\Scheduling\ScheduleDispatcher;
use Kode\Framework\Scheduling\TaskScanner;
use Kode\Framework\Server\HttpServer;
use Kode\Framework\Server\HotReloadWatcher;
use Kode\Framework\Server\ServerStatus;
use Kode\Framework\Server\ServerStatusStore;

$command = $argv[1] ?? 'help';
$args = array_slice($argv, 2);

match ($command) {
    'help'         => KodeCli::help(),
    'status'       => (new KodeStatusCommand())->run($args),
    'init'         => (new KodeInitCommand($packageRoot))->run($args),
    'start'        => (new KodeServeCommand())->run($args),
    'serve'        => (new KodeServeCommand())->run($args),
    'stop'         => (new KodeStopCommand())->run($args),
    'reload'       => (new KodeReloadCommand())->run($args),
    'restart'      => (new KodeRestartCommand())->run($args),
    'cron'         => (new KodeCronCommand())->run($args),
    'schedule:list' => (new KodeScheduleListCommand())->run($args),
    'route:list'   => (new KodeConsoleCommand())->run(array_merge(['route:list'], $args)),
    'process:list' => (new KodeConsoleCommand())->run(array_merge(['process:list'], $args)),
    'process:check' => (new KodeConsoleCommand())->run(array_merge(['process:check'], $args)),
    'migrate'        => (new KodeConsoleCommand())->run(array_merge(['migrate'], $args)),
    'migrate:rollback' => (new KodeConsoleCommand())->run(array_merge(['migrate:rollback'], $args)),
    'migrate:reset' => (new KodeConsoleCommand())->run(array_merge(['migrate:reset'], $args)),
    'make:controller' => (new KodeConsoleCommand())->run(array_merge(['make:controller'], $args)),
    'make:model'     => (new KodeConsoleCommand())->run(array_merge(['make:model'], $args)),
    'make:migration' => (new KodeConsoleCommand())->run(array_merge(['make:migration'], $args)),
    'make:middleware' => (new KodeConsoleCommand())->run(array_merge(['make:middleware'], $args)),
    'make:command'   => (new KodeConsoleCommand())->run(array_merge(['make:command'], $args)),
    'db:seed'      => (new KodeConsoleCommand())->run(array_merge(['db:seed'], $args)),
    'console'      => (new KodeConsoleCommand())->run($args),
    default        => (new KodeConsoleCommand())->run(array_merge([$command], $args)),
};

exit(0);

// ============================================================
// 初始化：生成 .env 与存储目录（composer create-project 后自动执行）
// ============================================================
final class KodeInitCommand
{
    /** 运行时存储子目录（仅保留 .gitkeep，内容随 .gitignore 忽略） */
    private const STORAGE_DIRS = ['logs', 'cache', 'framework/cache', 'framework/sessions', 'framework/views'];

    public function __construct(private string $projectRoot)
    {
    }

    public function run(array $args): void
    {
        // 1) .env（由 .env.example 生成，避免直接提交密钥）
        $example = $this->projectRoot . '/.env.example';
        $env = $this->projectRoot . '/.env';
        if (is_file($example) && !is_file($env)) {
            copy($example, $env);
            @chmod($env, 0600);
            // 将占位密钥替换为强随机值（H2）：避免 cp .env.example 即生产可用的裸奔。
            $raw = @file_get_contents($env);
            if (is_string($raw) && str_contains($raw, 'change-me')) {
                $strong = bin2hex(random_bytes(32));
                $raw = str_replace('change-me-to-a-long-random-string', $strong, $raw);
                $raw = str_replace('change-me', $strong, $raw);
                @file_put_contents($env, $raw);
            }
            echo "✅ 已生成 .env（已写入强随机 JWT_SECRET，权限 0600）\n";
        } elseif (is_file($env)) {
            // 已有 .env：确保权限收紧
            @chmod($env, 0600);
        }

        // 2) 存储目录（运行时写入，随 .gitignore 忽略内容，仅保留 .gitkeep）
        foreach (self::STORAGE_DIRS as $sub) {
            $this->ensureDir($this->projectRoot . '/storage/' . $sub);
        }

        echo "✅ 基础架构初始化完成（.env + storage/）\n";
    }

    private function ensureDir(string $path): void
    {
        if (!is_dir($path)) {
            @mkdir($path, 0o755, true);
        }
        $keep = $path . '/.gitkeep';
        if (!is_file($keep)) {
            file_put_contents($keep, '');
        }
    }
}

// ============================================================
// 多进程 HTTP 服务（基于 kode/process）
// ============================================================
/**
 * serve 与控制类命令（stop/reload/restart）的公共部分：配置与 PID 文件解析。
 *
 * PID 文件路径统一走 {@see HttpServer::resolveRuntimePaths()}，
 * 与 serve 启动时写 PID 文件用的是同一套规则——否则改了配置就会出现
 * 「启得来、停不掉」的经典漂移。
 */
abstract class KodeServerCommand
{
    /**
     * 读取 config/server.php，缺省时回退到内置默认。
     *
     * @return array<string, mixed>
     */
    protected function loadServerConfig(string $root): array
    {
        $file = $root . '/config/server.php';
        if (!is_file($file)) {
            return [];
        }

        $config = (require $file) ?: [];
        return is_array($config) ? $config : [];
    }

    /** @return array{pid_file: string, log_file: string, runtime_dir: string} */
    protected function runtimePaths(string $root): array
    {
        return HttpServer::resolveRuntimePaths($root, $this->loadServerConfig($root));
    }

    /** 读取 PID 文件；缺失或内容非法时返回 null。 */
    protected function readPid(string $file): ?int
    {
        if (!is_file($file)) {
            return null;
        }

        $raw = @file_get_contents($file);
        if (!is_string($raw) || trim($raw) === '') {
            return null;
        }

        $pid = (int) trim($raw);

        return $pid > 1 ? $pid : null;
    }

    protected function isRunning(int $pid): bool
    {
        return $pid > 1 && function_exists('posix_kill') && @posix_kill($pid, 0);
    }

    /** 轮询等待进程退出；返回 true 表示已在超时前退出。 */
    protected function waitExit(int $pid, float $timeout): bool
    {
        $deadline = microtime(true) + $timeout;
        while (microtime(true) < $deadline) {
            if (!$this->isRunning($pid)) {
                return true;
            }
            usleep(100_000);
        }

        return !$this->isRunning($pid);
    }
}

final class KodeServeCommand extends KodeServerCommand
{
    public function run(array $args): void
    {
        $host = null;
        $port = null;
        $workers = null;
        $runtime = null;
        $graceful = null;
        $watch = false;
        $daemon = false;
        $serveArgs = [];

        for ($i = 0; $i < count($args); $i++) {
            if ($args[$i] === '--watch') {
                $watch = true;
            } elseif ($args[$i] === '--daemon' || $args[$i] === '-d') {
                // 守护化：脱离终端、写 PID 文件（stop/reload/status 依赖它）。
                $daemon = true;
                $serveArgs[] = '--daemon';
            } elseif ($args[$i] === '--host' && isset($args[$i + 1])) {
                $host = $args[++$i];
                $serveArgs[] = '--host';
                $serveArgs[] = $host;
            } elseif ($args[$i] === '--port' && isset($args[$i + 1])) {
                $port = (int) $args[++$i];
                $serveArgs[] = '--port';
                $serveArgs[] = (string) $port;
            } elseif ($args[$i] === '--workers' && isset($args[$i + 1])) {
                $workers = max(1, (int) $args[++$i]);
                $serveArgs[] = '--workers';
                $serveArgs[] = (string) $workers;
            } elseif ($args[$i] === '--runtime' && isset($args[$i + 1])) {
                $runtime = $args[++$i];
                $serveArgs[] = '--runtime';
                $serveArgs[] = $runtime;
            } elseif ($args[$i] === '--graceful' && isset($args[$i + 1])) {
                // 优雅停机宽限（秒）：Ctrl+C / stop 后留给在途请求排空的最长时间。
                $graceful = max(0, (int) $args[++$i]);
                $serveArgs[] = '--graceful';
                $serveArgs[] = (string) $graceful;
            }
        }

        $root = getcwd();

        $config = $this->loadServerConfig($root);
        if ($host !== null) {
            $config['host'] = $host;
        }
        if ($port !== null) {
            $config['port'] = $port;
        }
        if ($workers !== null) {
            $config['workers'] = $workers;
        }
        if ($runtime !== null) {
            $config['runtime'] = $runtime;
        }
        if ($graceful !== null) {
            $config['graceful_shutdown_timeout'] = $graceful;
        }
        if ($daemon) {
            $config['daemonize'] = true;
        }

        if ($watch) {
            // 开发期热重载：把真实 serve 作为子进程，父进程监听文件变化后自动重启。
            // 守护化与热重载互斥：-d 脱离终端后看门狗的输出无处可去，也没有意义。
            (new HotReloadWatcher($root, $serveArgs))->run();
            exit(0);
        }

        try {
            HttpServer::make($config)->run($root);
        } catch (\Throwable $e) {
            KodeCli::fail($e);
        }
    }
}

/**
 * 停止服务（对标 workerman 的 `php start.php stop`）。
 *
 * 默认发 SIGTERM 走优雅停机（在途请求排空后才退出），`-g` 直接 SIGKILL 强杀。
 * 宽限超时后自动升级为 SIGKILL，避免「停不掉」时命令永久挂住。
 */
final class KodeStopCommand extends KodeServerCommand
{
    public function run(array $args): void
    {
        $root    = getcwd();
        $paths   = $this->runtimePaths($root);
        $pid     = $this->readPid($paths['pid_file']);
        $force   = in_array('-g', $args, true) || in_array('--force', $args, true);

        if ($pid === null || !$this->isRunning($pid)) {
            // 已经停了就不报错：stop 是幂等操作，便于在脚本 / CI 里重复执行。
            if (is_file($paths['pid_file'])) {
                @unlink($paths['pid_file']);
            }
            echo "服务未运行（PID 文件：{$paths['pid_file']}）\n";
            exit(0);
        }

        if (!function_exists('posix_kill')) {
            fwrite(STDERR, "当前 PHP 缺少 ext-posix，无法发送停止信号。\n");
            exit(1);
        }

        $graceful = max(0, (int) ($this->loadServerConfig($root)['graceful_shutdown_timeout'] ?? 3));

        if ($force) {
            @posix_kill($pid, SIGKILL);
            $this->waitExit($pid, 5.0);
            echo "已强制停止服务（pid={$pid}）\n";
            exit(0);
        }

        @posix_kill($pid, SIGTERM);

        // 宽限 = 配置的排空时间 + 5s 收割余量；超时说明有请求卡死，升级强杀。
        if (!$this->waitExit($pid, $graceful + 5.0)) {
            @posix_kill($pid, SIGKILL);
            $this->waitExit($pid, 5.0);
            echo "优雅停机超时，已强制停止服务（pid={$pid}）\n";
            exit(0);
        }

        echo "已停止服务（pid={$pid}）\n";
        exit(0);
    }
}

/**
 * 平滑重载（对标 workerman 的 `php start.php reload`）。
 *
 * 只重建 worker 进程、不动 master：新代码在下一个 worker 上生效，
 * 已建立的长连接由旧 worker 处理到自然结束，因此不会中断在途请求。
 */
final class KodeReloadCommand extends KodeServerCommand
{
    public function run(array $args): void
    {
        $root  = getcwd();
        $paths = $this->runtimePaths($root);
        $pid   = $this->readPid($paths['pid_file']);

        if ($pid === null || !$this->isRunning($pid)) {
            fwrite(STDERR, "服务未运行，无法 reload（PID 文件：{$paths['pid_file']}）\n");
            exit(1);
        }

        // SIGUSR1：kode/process master 收到后逐个通知 worker 退出并由 master 重新拉起。
        @posix_kill($pid, SIGUSR1);
        echo "已发送 SIGUSR1 给 master（pid={$pid}），worker 将逐个平滑重启\n";
        exit(0);
    }
}

/**
 * 重启服务：先 stop 再以守护模式重新拉起（对标 workerman 的 `restart`）。
 */
final class KodeRestartCommand extends KodeServerCommand
{
    public function run(array $args): void
    {
        (new KodeStopCommand())->run([]);

        $root = getcwd();
        // 与终端彻底脱钩：restart 拉起的服务必须活过当前 shell，故固定走守护模式。
        $cmd = sprintf(
            '%s %s serve --daemon %s >> %s 2>&1 &',
            escapeshellarg(PHP_BINARY),
            escapeshellarg($root . '/bin/kode'),
            implode(' ', array_map('escapeshellarg', $this->serveArgs($args))),
            escapeshellarg($this->runtimePaths($root)['log_file'])
        );

        @exec($cmd);
        echo "服务已重启（守护模式），用 `bin/kode status` 查看进程表\n";
        exit(0);
    }

    /**
     * @param list<string> $args
     * @return list<string>
     */
    private function serveArgs(array $args): array
    {
        // restart 自身不带 --daemon 之外的 serve 选项时，透传用户给的 --host/--port 等。
        $pass = [];
        foreach ($args as $arg) {
            if ($arg === '--daemon' || $arg === '-d') {
                continue;
            }
            $pass[] = $arg;
        }

        return $pass;
    }
}

// ============================================================
// 控制台透传
// ============================================================
final class KodeConsoleCommand
{
    public function run(array $args): void
    {
        try {
            $root = getcwd();
            $app = Application::make($root);
            $code = $app->console()->run(array_merge([$GLOBALS['argv'][0] ?? 'kode'], $args));
            exit(is_int($code) ? $code : 0);
        } catch (\Throwable $e) {
            KodeCli::fail($e);
        }
    }
}

// ============================================================
// 定时任务调度（基于 kode/process 定时器，约定优于配置）
// ============================================================
class KodeScheduleCommand
{
    /**
     * 根据 config/schedule.php 计算任务目录（key=来源标签）。
     *
     * @return array<string, string>
     */
    protected function taskDirs(Application $app): array
    {
        $cfg = $app->config()->get('schedule', []);
        $cfg = is_array($cfg) ? $cfg : [];

        $dirs = [];
        foreach ($cfg['paths'] ?? [] as $label => $dir) {
            // config 里是「相对项目根」的子路径；用 Application 的真实 basePath 拼成绝对路径，
            // 保证从不同工作目录启动时任务发现一致（不依赖当前 CWD）。
            $dirs[$label] = is_absolute_path($dir) ? $dir : $app->basePath($dir);
        }

        if (!empty($cfg['discover_plugins'])) {
            foreach (glob(base_path('plugins/*'), GLOB_ONLYDIR) ?: [] as $plugin) {
                $name = basename($plugin);
                $dirs['plugin:' . $name] = $plugin . '/src/Tasks';
            }
        }

        return $dirs;
    }

    protected function scanner(): TaskScanner
    {
        return new TaskScanner(new Reader());
    }
}

final class KodeCronCommand extends KodeScheduleCommand
{
    public function run(array $args): void
    {
        try {
            $root = getcwd();
            $app = Application::make($root);
        } catch (\Throwable $e) {
            KodeCli::fail($e);
        }

        $runOnce = null;
        foreach ($args as $a) {
            if (str_starts_with($a, '--run=')) {
                $runOnce = substr($a, strlen('--run='));
            }
        }

        $tasks = $this->scanner()->scan($this->taskDirs($app));
        $dispatcher = new ScheduleDispatcher();
        $dispatcher->register($tasks);

        if ($runOnce !== null) {
            if ($dispatcher->runOnce($runOnce)) {
                echo sprintf("已手动触发任务 %s\n", $runOnce);
                exit(0);
            }
            fwrite(STDERR, sprintf("未找到任务 %s（用 schedule:list 查看可用任务）\n", $runOnce));
            exit(1);
        }

        $runSingle = in_array('--run-once', $args, true);

        $n = count(array_filter($dispatcher->registered(), static fn ($t) => $t->enabled));
        if ($n === 0) {
            echo "未发现任何启用的 #[Cron] 任务。请在 app/tasks 下用 #[Cron] 声明任务。\n";
            exit(0);
        }

        if ($runSingle) {
            // 单轮执行（适合由系统 crontab 每分钟触发一次；不进入常驻循环）。
            echo sprintf("已注册 %d 条定时任务，执行单轮调度...\n", $n);
            $report = $dispatcher->run();
            printf(
                "调度完成：成功 %d / 失败 %d / 跳过 %d\n",
                $report->succeededCount(),
                $report->failedCount(),
                $report->skippedCount()
            );
            exit(0);
        }

        // 默认常驻：keepAlive 守护循环，Ctrl+C 优雅退出。
        echo sprintf("已注册 %d 条定时任务，启动调度器（常驻）...\n", $n);
        $dispatcher->daemon();
        exit(0);
    }
}

final class KodeScheduleListCommand extends KodeScheduleCommand
{
    public function run(array $args): void
    {
        try {
            $root = getcwd();
            $app = Application::make($root);
        } catch (\Throwable $e) {
            KodeCli::fail($e);
        }

        $tasks = $this->scanner()->scan($this->taskDirs($app));

        if ($tasks === []) {
            echo "未发现任何 #[Cron] 任务。\n";
            exit(0);
        }

        $enabled = count(array_filter($tasks, static fn ($t) => $t->enabled));
        printf("共 %d 条任务（启用 %d）：\n\n", count($tasks), $enabled);
        printf("  %-22s %-16s %-10s %-12s %s\n", 'NAME', 'EXPRESSION', 'SOURCE', 'MODE', 'TARGET');
        printf("  %s\n", str_repeat('-', 78));

        foreach ($tasks as $t) {
            printf(
                "  %-22s %-16s %-10s %-12s %s\n",
                $t->name,
                $t->expression,
                $t->source,
                $t->cluster ? 'cluster' : 'local',
                ($t->enabled ? '' : '(disabled) ') . $t->target(),
            );
        }

        exit(0);
    }
}

// ============================================================
// 状态检查：对标 workerman status
// ============================================================
final class KodeStatusCommand extends KodeServerCommand
{
    public function run(array $args): void
    {
        // 旧版框架（< v1.1.0）没有状态表组件：给出可执行的升级指引，
        // 而不是抛一个「Class not found」把用户晾在原地。
        if (!class_exists(ServerStatus::class) || !class_exists(ServerStatusStore::class)) {
            fwrite(STDERR, "当前安装的 kode/framework 版本不支持进程状态表（需 >= 1.1.0）。\n");
            fwrite(STDERR, "请执行：composer update kode/framework\n");
            exit(1);
        }

        $onlyPid = null;
        foreach ($args as $arg) {
            if (str_starts_with($arg, '--pid=')) {
                $onlyPid = max(0, (int) substr($arg, strlen('--pid=')));
            }
        }

        $root    = getcwd();
        $config  = $this->loadServerConfig($root);
        $store   = ServerStatusStore::forRoot($root, isset($config['runtime_path']) ? (string) $config['runtime_path'] : null);
        $status  = new ServerStatus($store);

        echo $status->render($onlyPid);

        if (!$status->isRunning()) {
            fwrite(STDERR, "提示：先用 `bin/kode serve` 或 `bin/kode serve --daemon` 启动服务。\n");
            exit(1);
        }

        exit(0);
    }
}

// ============================================================
final class KodeCli
{
    /**
     * 命令行「最后一道防线」：把启动期 / 未捕获的异常转成清晰的报错，
     * 而非裸堆栈，并以非 0 退出码结束（便于 CI / 编排系统感知失败）。
     *
     * APP_DEBUG=true（或环境变量 APP_DEBUG=true）时附上堆栈，便于本地排查。
     */
    public static function fail(\Throwable $e): never
    {
        fwrite(STDERR, "\n❌ " . get_class($e) . ': ' . $e->getMessage() . "\n");

        $debug = ($_SERVER['APP_DEBUG'] ?? null) === 'true'
            || ($_ENV['APP_DEBUG'] ?? null) === 'true'
            || (getenv('APP_DEBUG') ?: 'false') === 'true';

        if ($debug) {
            fwrite(STDERR, $e->getTraceAsString() . "\n");
        }

        exit(1);
    }

    public static function help(): void
    {
        echo "Kode Framework 命令行工具\n\n";
        echo "  composer create-project kode/skeleton <项目名>   一句话安装（下载 + composer install + 初始化）\n";
        echo "  bin/kode init                    初始化当前项目（生成 .env + storage/）\n";
        echo "  bin/kode start [--host H] [--port P] [--workers N] [--watch] [--daemon|-d] [--graceful N]\n";
        echo "                                    启动多进程 HTTP 服务（--watch 开热重载，-d 守护化；serve 为别名）\n";
        echo "  bin/kode stop [-g]                 停止服务（默认优雅停机，-g 强制 SIGKILL）\n";
        echo "  bin/kode reload                    平滑重启 worker（不中断在途请求）\n";
        echo "  bin/kode restart [--host H] [--port P]   停止并以守护模式重新拉起\n";
        echo "  bin/kode status [--pid=N]          查看服务状态（对标 workerman status；--pid 看单进程）\n";
        echo "  bin/kode cron                     常驻运行 #[Cron] 定时任务（Ctrl+C 优雅退出）\n";
        echo "  bin/kode schedule:list            列出所有已发现的 #[Cron] 定时任务\n";
        echo "  bin/kode console <args...>         透传执行控制台命令\n";
        echo "  bin/kode migrate                   执行待运行的数据库迁移\n";
        echo "  bin/kode migrate:rollback          回滚最近一批迁移\n";
        echo "  bin/kode migrate:reset             回滚全部迁移\n";
        echo "  bin/kode db:seed [--class=Name]    运行数据库填充\n";
        echo "  bin/kode make:controller <Name>    生成 HTTP 控制器\n";
        echo "  bin/kode make:model <Name>         生成数据模型\n";
        echo "  bin/kode make:migration <name>     生成数据库迁移\n";
        echo "  bin/kode make:middleware <Name>    生成 HTTP 中间件\n";
        echo "  bin/kode make:command <Name>       生成控制台命令\n";
        echo "  bin/kode apidoc:generate [--output=] [--check]   生成/校验 OpenAPI 文档\n";
        echo "  bin/kode help                      显示本帮助\n\n";
        echo "serve 选项：--host 127.0.0.1  --port 9527  --workers 4  --graceful 3  --daemon\n";
        echo "进程表数据来自各 worker 的 1Hz 心跳，写在 storage/runtime/（可随时删除，会自动重建）\n";
        echo "cron 任务用 #[Cron('分 时 日 月 周')] 声明，见 app/tasks 示例\n";
        echo "迁移文件放在 database/migrations/，文件名形如 2024_01_01_000000_create_users_table.php\n";
        exit(0);
    }
}

/**
 * 判断路径是否为绝对路径（跨平台）。
 */
function is_absolute_path(string $path): bool
{
    if ($path === '' || $path === '/') {
        return true;
    }

    if (DIRECTORY_SEPARATOR === '\\') {
        return (bool) preg_match('#^[A-Za-z]:[\\\\/]#', $path) || str_starts_with($path, '\\\\');
    }

    return str_starts_with($path, '/');
}
